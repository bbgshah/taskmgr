#include <windows.h>
#include "resource.h"

IDI_APP ICON "taskmgr.ico"
1 24 "taskmgr.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Subhajit Maji"
            VALUE "FileDescription",  "Task Manager"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "taskmgr"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Subhajit Maji. All rights reserved."
            VALUE "OriginalFilename", "taskmgr.exe"
            VALUE "ProductName",      "Task Manager"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
